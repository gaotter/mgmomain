@page "/post/{PostId:int}"
@using Mgmo.Main.Blog.Core.Contracts
@using Mgmo.Main.Blog.Core.Dto
@inject IBlogPostsBlo BlogPostsBlo

@if (BlogPost is not null)
{
    
    <div class="page-main-content">
        @if (BlogPost.MainImageUrl is not null)
        {
            <section class="main-image">
                <img src="@BlogPost.MainImageUrl" alt="@BlogPost.Title" />
            </section>
        }
        <section class="content">
            <h1>@BlogPost.Title</h1>
            <p>@BlogPost.Content</p>
        </section>
        
    </div>
}
else
{
    <p>Loading...</p>
}


@code {
    [Parameter]
    public int PostId { get; set; } = 0;

    private BlogPostDto? BlogPost { get; set; }

    protected override async Task OnInitializedAsync()
    {
        BlogPost = await BlogPostsBlo.GetBlogAsync(PostId.ToString(), "Testing");
    }
}
