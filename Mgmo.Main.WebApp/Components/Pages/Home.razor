@page "/"
@using Mgmo.Main.Blog.Core.Contracts
@using Mgmo.Main.Blog.Core.Dto
@using Mgmo.Main.Blog.Services.Services
@inject BlogService BlogPostsStorageHandler
@rendermode InteractiveServer

<PageTitle>Mgmo Main</PageTitle>

<h1>Hello welcome to may page</h1>

@if (BlogPosts != null)
{
    <ul>
        @foreach (var blogPost in BlogPosts)
        {
            <li>
                <a href="post/@blogPost.Id">  @blogPost.Title</a>
            </li>
        }
    </ul>
}

@if (pagingTokten is not null)
{
    <button @onclick="GetMorePosts">Get older posts</button>
}


@code {
    private List<BlogPostDto> BlogPosts { get; set; } = new List<BlogPostDto>();
    string? pagingTokten = null;

    protected override async Task OnInitializedAsync()
    {
        await BlogPostsStorageHandler.InitializeBlogPostService();
        var b = BlogPostsStorageHandler.InitialBlogPosts;

        BlogPosts = b.Posts.ToList();
        pagingTokten = b.PaginationContinueToken;
    }


    private async Task GetMorePosts()
    {
        var blobPosts = await BlogPostsStorageHandler.GetBlogPosts(pagingTokten);
        if (blobPosts.Posts is not null)
            BlogPosts.AddRange(blobPosts.Posts);

        pagingTokten = blobPosts.PaginationContinueToken;

    }


}
